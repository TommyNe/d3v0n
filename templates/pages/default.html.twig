{% extends "base.html.twig" %}

{% block content %}
    <div class="container">
        <article>
            <h1 class="mb-5">{{ content.title }}</h1>
            {% for item in content.blocks %}
                <h2 class="mb-3">{{ item.title }}</h2>
                {% if item.datetime is defined %}
                    <p class="blockquote-footer">{{ item.datetime|format_datetime('short', 'none', locale='de') }}</p>
                {% endif %}
                {% if item.image is defined %}
                    <img src="{{ item.image.url }}" alt="{{ item.image.title }}" width="200px">
                {% endif %}
                <p>{{ item.description|raw }}</p>
            {% endfor %}
        </article>
    </div>
{% endblock %}
